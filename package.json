{
  "name": "openfood-delivery-platform",
  "version": "0.1.0",
  "description": "OpenFood — A full-stack food delivery platform monorepo (UberEats-like)",
  "private": true,
  "workspaces": [
    "apps/backend"
  ],
  "scripts": {
    "start": "node apps/backend/src/index.js",
    "backend": "npm run dev --workspace=apps/backend",
    "backend:start": "npm run start --workspace=apps/backend",
    "test": "npm test --prefix apps/backend",
    "install:all": "npm install && cd apps/customer-app && npm install && cd ../restaurant-dashboard && npm install && cd ../rider-app && npm install"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "uuid": "^9.0.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Yawxplusonline/obroni-food-joint.git"
  },
  "license": "MIT",
  "author": "OpenFood Team"
}
