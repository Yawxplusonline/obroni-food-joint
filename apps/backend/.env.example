# =============================================================================
# OpenFood Backend — Environment Variables Template
# Copy to .env and fill in your values. Never commit .env.
# =============================================================================

# Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (used for client-level RLS-enforced queries)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — bypasses RLS. Keep this SECRET. Backend only.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Port for the Express server
PORT=3001

# Node environment: development | production | test
NODE_ENV=development
